# Copy to .env and fill in. Never commit .env (this repo is public).

# Firebase project, and the path to its service account key (Project settings > Service accounts >
# Generate new private key). Keep the key file OUTSIDE the repo. On Vercel, put the key's JSON in
# FIREBASE_SERVICE_ACCOUNT instead of a path.
FIREBASE_PROJECT_ID=healthbridge-rwanda
GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs the 10-minute token that lets a user set a new PIN or password after entering a reset code.
JWT_SECRET=

# Wraps device SMS keys at rest (64 hex chars) and authenticates the gateway callbacks.
# Callback URLs: https://<host>/webhooks/sms?secret=<SMS_WEBHOOK_SECRET> and .../webhooks/sms/delivery?secret=...
SMS_KEY_ENC_KEY=
SMS_WEBHOOK_SECRET=

# Africa's Talking (username 'sandbox' uses the simulator). Without them no SMS is sent:
# no acks, no reset codes, no CHW notices.
AT_USERNAME=
AT_API_KEY=
AT_SENDER=

# Browser origins allowed to call the API (comma-separated). Leave empty for any localhost port in dev.
CORS_ORIGINS=

PORT=3000

# Only for `npm run seed` (synthetic demo users). Pick your own; never reuse a real password.
SEED_PIN=
SEED_PASSWORD=
