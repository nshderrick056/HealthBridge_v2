# Copy to .env and fill in. Never commit .env (this repo is public).
# Local Postgres 16: both URLs can be the same. On Neon: DATABASE_URL = pooled, DIRECT_URL = direct.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthbridge
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/healthbridge

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Wraps device SMS keys at rest (64 hex chars) and authenticates the gateway callbacks.
# Callback URLs: https://<host>/webhooks/sms?secret=<SMS_WEBHOOK_SECRET> and .../webhooks/sms/delivery?secret=...
SMS_KEY_ENC_KEY=
SMS_WEBHOOK_SECRET=

# Africa's Talking (username 'sandbox' uses the simulator). Optional: without them no ack SMS is sent.
AT_USERNAME=
AT_API_KEY=
AT_SENDER=

# Browser origins allowed to call the API (comma-separated). Leave empty for any localhost port in dev.
CORS_ORIGINS=

PORT=3000

# Only for `npm run db:seed` (synthetic demo users). Pick your own; never reuse a real password.
SEED_PIN=
SEED_PASSWORD=
