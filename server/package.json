{
  "name": "healthbridge-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore,auth --project demo-healthbridge \"vitest run\"",
    "test:unit": "vitest run test/sms-codec.test.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "express": "5.3.0",
    "firebase-admin": "^14.5.1",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
