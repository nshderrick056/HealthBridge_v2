# Copy to .env.local and fill in. Never commit .env.local (this repo is public).
# Base URL of the HealthBridge API (server/). Read only on the server: the browser never calls it directly.
API_URL=http://localhost:3000

# Firebase web API key of project healthbridge-rwanda (public: it is also in android/app/google-services.json).
# Supervisors sign in with Firebase email + password; the key only identifies the project.
FIREBASE_WEB_API_KEY=
